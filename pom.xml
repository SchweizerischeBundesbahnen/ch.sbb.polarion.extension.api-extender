<?xml version="1.0" encoding="UTF-8"?>
<project>
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.sbb.polarion.extensions</groupId>
        <artifactId>ch.sbb.polarion.extension.generic</artifactId>
        <version>16.4.0</version>
    </parent>

    <artifactId>ch.sbb.polarion.extension.api-extender</artifactId>
    <version>5.4.0</version>
    <packaging>jar</packaging>

    <name>API extension for Polarion ALM</name>
    <description>This Polarion extension provides additional functionality which is not implemented in standard Polarion API for some reason</description>
    <url>https://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.api-extender</url>

    <licenses>
        <license>
            <name>The SBB License, Version 1.0</name>
            <url>https://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.api-extender/blob/main/NOTICE</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>SBB Polarion Team</name>
            <email>polarion-opensource@sbb.ch</email>
            <organization>SBB AG</organization>
            <organizationUrl>https://www.sbb.ch</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.api-extender.git</connection>
        <developerConnection>scm:git:ssh://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.api-extender.git</developerConnection>
        <url>https://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.api-extender/tree/main</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.api-extender/issues</url>
    </issueManagement>

    <properties>
        <maven-jar-plugin.Extension-Context>api-extender</maven-jar-plugin.Extension-Context>
        <maven-jar-plugin.Automatic-Module-Name>ch.sbb.polarion.extension.api_extender</maven-jar-plugin.Automatic-Module-Name>

        <web.app.name>${maven-jar-plugin.Extension-Context}</web.app.name>

        <!-- com.polarion.alm.wiki gives the wiki rendering context to Velocity 2 blocks in LiveDocs.
             org.objectweb.asm weaves the LiveReport script renderer, see Velocity2ScriptWeaver. -->
        <maven-jar-plugin.Require-Bundle>${maven-jar-plugin.Require-Bundle.common},com.polarion.alm.wiki,org.objectweb.asm</maven-jar-plugin.Require-Bundle>
        <!-- The weaving hook API comes from the Equinox system bundle. -->
        <maven-jar-plugin.Import-Package>org.osgi.framework,org.osgi.framework.hooks.weaving</maven-jar-plugin.Import-Package>
        <asm.version>9.9.1</asm.version>

        <velocity-tools.version>3.1</velocity-tools.version>
        <velocity-engine.version>2.4.1</velocity-engine.version>
        <commons-lang3.version>3.22.0</commons-lang3.version>
        <osgi-resource.version>1.0.1</osgi-resource.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.sbb.polarion.extensions</groupId>
            <artifactId>ch.sbb.polarion.extension.generic.app</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- Polarion renders scripts with its own Velocity v1.4 and Tools 2.0, so these jars load only through BundleJarsPrioritizingRunnable. -->
        <dependency>
            <groupId>org.apache.velocity.tools</groupId>
            <artifactId>velocity-tools-generic</artifactId>
            <version>${velocity-tools.version}</version>
            <exclusions>
                <!-- An embedded slf4j-api binds to Polarion's StaticLoggerBinder and fails with a loader constraint violation. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Velocity Tools 3.1 brings engine 2.3. -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
            <version>${velocity-engine.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Velocity Tools 3.1 brings 3.10, engine 2.4.1 is built against 3.17.0. -->
        <!-- Polarion ships the same version as the bundle org.objectweb.asm. -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>

        <dependency>
            <groupId>com.polarion.alm.wiki</groupId>
            <artifactId>sidecar</artifactId>
            <version>${polarion.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>ch.sbb.polarion.extensions</groupId>
            <artifactId>ch.sbb.polarion.extension.generic.app</artifactId>
            <version>${project.parent.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Mockito needs it to mock WovenClass, whose BundleWiring extends org.osgi.resource.Wiring. -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.resource</artifactId>
            <version>${osgi-resource.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset>
                            <!-- Everything markdown2html renders below (the parent only knows about.html);
                                 the same files .gitignore keeps out of git. -->
                            <directory>${markdown2html-maven-plugin.extensionContextAdminHtml}</directory>
                            <includes>
                                <include>*.html</include>
                            </includes>
                            <followSymlinks>false</followSymlinks>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>

            <plugin>
                <groupId>ch.sbb.maven.plugins</groupId>
                <artifactId>markdown2html-maven-plugin</artifactId>
                <!--
                    Renders the About page (README.md) and the documentation-site articles of
                    ui/src/docs/docs.config.json into the app webapp's html/, which the app fetches them from.

                    The plugin-level configuration is shared by every execution: the parent's (failOnError,
                    generateHeadingIds, openExternalLinksInNewTab, its excludeChapters and removeLinesWithStrings)
                    plus the two below. An execution only names its input and output, and replaces the parent's
                    excludeChapters where it lists its own.

                    Every execution runs in generate-sources, one phase before the frontend build in
                    generate-resources: build-docs-index.mjs (npm `prebuild`) builds the documentation search
                    index from this very HTML, using the heading ids generateHeadingIds stamps on it, and fails
                    the build when an article is missing. An article added to the manifest needs an execution here.
                -->
                <configuration>
                    <!-- Keep relative links relative: the app's DocLinkInterceptor turns a link to another
                         article into in-app navigation, and any other one (docs/openapi.json) into a GitHub link.
                         combine.self=override is required: an empty element alone does not override the
                         parent's ${project.scm.url}, Maven keeps the inherited value on an empty merge. -->
                    <relativeLinkPrefix combine.self="override"/>
                    <!-- The articles are fetched as single files, so their images travel inside them. -->
                    <imageProcessingType>EMBED</imageProcessingType>
                </configuration>
                <executions>
                    <execution>
                        <id>readme.md-to-about.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                    </execution>
                    <!-- The documentation-site articles, in the reading order of ui/src/docs/docs.config.json. -->
                    <execution>
                        <id>quick_start.md-to-quick-start.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.basedir}/QUICK_START.md</inputFile>
                            <outputFile>${markdown2html-maven-plugin.extensionContextAdminHtml}/quick-start.html</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>user_guide.md-to-user-guide.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.basedir}/USER_GUIDE.md</inputFile>
                            <outputFile>${markdown2html-maven-plugin.extensionContextAdminHtml}/user-guide.html</outputFile>
                            <!-- The markdown keeps a Table of contents for GitHub; the sidebar and "On this page"
                                 of the documentation site provide that navigation, so drop it here. -->
                            <excludeChapters>
                                <excludeChapter>## Table of contents</excludeChapter>
                            </excludeChapters>
                        </configuration>
                    </execution>
                    <execution>
                        <id>rest_api.md-to-rest-api.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.basedir}/REST_API.md</inputFile>
                            <outputFile>${markdown2html-maven-plugin.extensionContextAdminHtml}/rest-api.html</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>velocity_tools.md-to-velocity-tools.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.basedir}/VELOCITY_TOOLS.md</inputFile>
                            <outputFile>${markdown2html-maven-plugin.extensionContextAdminHtml}/velocity-tools.html</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>velocity_2.md-to-velocity-2.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.basedir}/VELOCITY_2.md</inputFile>
                            <outputFile>${markdown2html-maven-plugin.extensionContextAdminHtml}/velocity-2.html</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-maven-plugin-jakarta</artifactId>
                <configuration>
                    <outputFormat>JSON</outputFormat>
                    <resourcePackages>
                        <package>ch.sbb.polarion.extension.generic.rest.controller.info</package>
                        <package>ch.sbb.polarion.extension.generic.rest.controller.roles</package>
                        <package>ch.sbb.polarion.extension.generic.rest.controller.settings</package>
                        <package>ch.sbb.polarion.extension.generic.rest.model</package>
                        <package>ch.sbb.polarion.extension.api_extender.rest.controller</package>
                        <package>ch.sbb.polarion.extension.api_extender.rest.model</package>
                    </resourcePackages>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.github.grigoriev</groupId>
                <artifactId>pre-commit-run-maven-plugin</artifactId>
            </plugin>
            <!-- Opts in to the compatibility check the generic parent pom declares. -->
            <plugin>
                <groupId>com.intechcore</groupId>
                <artifactId>polarion-compatibility-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>
</project>
