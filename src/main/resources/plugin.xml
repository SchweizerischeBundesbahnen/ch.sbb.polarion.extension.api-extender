<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin>
    <!-- Two webapp contexts: the REST API, and the React app - which serves both the Vite bundle and
         the administration-menu icons. One extension element holds them, as Polarion's own
         com.polarion.alm.ui does. -->
    <extension
            point="com.polarion.portal.tomcat.webapps">
        <webapp
                name="polarion/api-extender"
                contextRoot="webapp/api-extender">
        </webapp>
        <webapp
                name="polarion/api-extender-app"
                contextRoot="webapp/api-extender-app">
        </webapp>
    </extension>

    <!-- Polarion renders a <script> tag for this file into the main portal page, without the scriptInjection.*
         administrator configuration. The servlet serves it flat by its base name at
         /polarion/codemirror-modes/api-extender-ui-loader.js, so the name must stay unique across all plugins.
         The response is cached as immutable, so the file only loads webapp/api-extender-app/js/api-extender-ui.js,
         which holds the actual UI additions.
         Point `location` at a single file: a directory contributes every file in it to every Polarion page.
         The extension registry is read at startup, so a change here needs a Polarion restart. -->
    <extension
            point="com.polarion.portal.tomcat.externalJsFile">
        <file location="external-js/api-extender-ui-loader.js"/>
    </extension>
</plugin>
